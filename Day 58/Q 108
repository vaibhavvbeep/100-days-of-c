//Q108: Write a Program to take an integer array nums. Print an array answer such that answer[i] is equal to the product of all the elements of nums except nums[i]. The product of any prefix or suffix of nums is guaranteed to fit in a 32-bit integer.
#include <stdio.h>

int main() {
    int n, i;

    if (scanf("%d", &n) == 1) {
        int nums[n], ans[n];
        for (i = 0; i < n; i++) {
            scanf("%d", &nums[i]);
        }

        int prefix = 1;
        for (i = 0; i < n; i++) {
            ans[i] = prefix;
            prefix *= nums[i];
        }

        int suffix = 1;
        for (i = n - 1; i >= 0; i--) {
            ans[i] *= suffix;
            suffix *= nums[i];
        }

        printf("[");
        for (i = 0; i < n; i++) {
            if (i == n - 1) {
                printf("%d", ans[i]);
            } else {
                printf("%d,", ans[i]);
            }
        }
        printf("]\n");
    }

    return 0;
}