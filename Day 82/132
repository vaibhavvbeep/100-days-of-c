#include <stdio.h>

enum TrafficLight {
    RED,
    YELLOW,
    GREEN
};

int main() {
    char input[20];
    enum TrafficLight light;

    if (scanf("%19s", input) != 1) {
        return 1;
    }

    if (input[0] == 'R') {
        light = RED;
    } else if (input[0] == 'Y') {
        light = YELLOW;
    } else if (input[0] == 'G') {
        light = GREEN;
    } else {
        return 1;
    }

    switch (light) {
        case RED:    printf("Stop\n"); break;
        case YELLOW: printf("Wait\n"); break;
        case GREEN:  printf("Go\n"); break;
    }

    return 0;
}