//Q74: Find the transpose of a matrix.
#include <stdio.h>

int main() {
    int rows, cols, i, j;

    scanf("%d %d", &rows, &cols);

    int a[rows][cols];

    for (i = 0; i < rows; i++) {
        for (j = 0; j < cols; j++) {
            scanf("%d", &a[i][j]);
        }
    }

    for (i = 0; i < cols; i++) {
        for (j = 0; j < rows; j++) {
            printf("%d ", a[j][i]);
        }
        printf("\n");
    }

    return 0;
}