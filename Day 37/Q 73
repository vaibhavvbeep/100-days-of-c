//Q73: Find the sum of each row of a matrix and store it in an array.
#include <stdio.h>

int main() {
    int rows, cols, i, j;

    scanf("%d %d", &rows, &cols);

    int a[rows][cols];
    int row_sum[rows];

    for (i = 0; i < rows; i++) {
        row_sum[i] = 0;
        for (j = 0; j < cols; j++) {
            scanf("%d", &a[i][j]);
            row_sum[i] += a[i][j];
        }
    }

    for (i = 0; i < rows; i++) {
        printf("%d ", row_sum[i]);
    }
    printf("\n");

    return 0;
}