#include <stdio.h>

int main() {
    int n, i, x;
    int freq[10000] = {0};

    if (scanf("%d", &n) == 1) {
        for (i = 0; i < n; i++) {
            scanf("%d", &x);
            if (freq[x] == 1) {
                printf("%d\n", x);
                return 0;
            }
            freq[x] = 1;
        }
    }

    return 0;
}