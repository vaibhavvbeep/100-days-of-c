//120: Write a program to take a string input. Change it to sentence case.
#include <stdio.h>

int main() {
    char str[1000];
    int i = 0, new_word = 1;

    if (fgets(str, sizeof(str), stdin) != NULL) {
        while (str[i] != '\0') {
            if (str[i] == '\n') {
                str[i] = '\0';
                break;
            }
            if (str[i] == ' ' || str[i] == '\t') {
                new_word = 1;
            } else {
                if (new_word) {
                    if (str[i] >= 'a' && str[i] <= 'z') {
                        str[i] = str[i] - 'a' + 'A';
                    }
                    new_word = 0;
                } else {
                    if (str[i] >= 'A' && str[i] <= 'Z') {
                        str[i] = str[i] - 'A' + 'a';
                    }
                }
            }
            i++;
        }
        printf("%s\n", str);
    }

    return 0;
}