#include <stdio.h>

struct Student {
    char name[100];
    int roll_no;
    int marks;
};

struct Student getTopStudent(struct Student s[], int n) {
    int i, top_idx = 0;

    for (i = 1; i < n; i++) {
        if (s[i].marks > s[top_idx].marks) {
            top_idx = i;
        }
    }

    return s[top_idx];
}

int main() {
    int n, i;

    if (scanf("%d", &n) != 1 || n <= 0) {
        return 1;
    }

    struct Student s[n];

    for (i = 0; i < n; i++) {
        if (scanf("%99s %d %d", s[i].name, &s[i].roll_no, &s[i].marks) != 3) {
            return 1;
        }
    }

    struct Student top = getTopStudent(s, n);
    printf("Top Student: %s | Roll: %d | Marks: %d\n", top.name, top.roll_no, top.marks);

    return 0;
}