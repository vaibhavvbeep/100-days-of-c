#include <stdio.h>

struct Date {
    int day;
    int month;
    int year;
};

struct Employee {
    char name[100];
    int id;
    struct Date joining_date;
};

int main() {
    struct Employee emp;

    if (scanf("%99s %d %d %d %d",
              emp.name,
              &emp.id,
              &emp.joining_date.day,
              &emp.joining_date.month,
              &emp.joining_date.year) != 5) {
        return 1;
    }

    printf("Name: %s | ID: %d | Joining Date: %02d/%02d/%04d\n",
           emp.name,
           emp.id,
           emp.joining_date.day,
           emp.joining_date.month,
           emp.joining_date.year);

    return 0;
}