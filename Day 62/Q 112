//Q112: Write a program to take an integer array arr as input. The task is to find the maximum sum of any contiguous subarray using Kadane's algorithm. Print the maximum sum as output. If all elements are negative, print the largest (least negative) element.
#include <stdio.h>

int maxSubarraySum(int arr[], int n) {
    // Initialize max_so_far and curr_max with the first element
    int max_so_far = arr[0];
    int curr_max = arr[0];

    for (int i = 1; i < n; i++) {
        // Decide whether to add current element to existing subarray or start a new subarray
        if (arr[i] > curr_max + arr[i]) {
            curr_max = arr[i];
        } else {
            curr_max = curr_max + arr[i];
        }

        // Update max_so_far if curr_max is greater
        if (curr_max > max_so_far) {
            max_so_far = curr_max;
        }
    }

    return max_so_far;
}

int main() {
    int n;

    // Read size of array
    if (scanf("%d", &n) != 1 || n <= 0) {
        return 0;
    }

    int arr[n];

    // Read array elements
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    // Compute and print the maximum subarray sum
    int maxSum = maxSubarraySum(arr, n);
    printf("%d\n", maxSum);

    return 0;
}