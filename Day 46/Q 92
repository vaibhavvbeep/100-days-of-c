//Q92: Find the first repeating lowercase alphabet in a string.
#include <stdio.h>

int main() {
    char str[1000];
    int freq[26] = {0};
    int i = 0;

    if (scanf("%s", str) == 1) {
        while (str[i] != '\0') {
            if (str[i] >= 'a' && str[i] <= 'z') {
                freq[str[i] - 'a']++;
                if (freq[str[i] - 'a'] == 2) {
                    printf("%c\n", str[i]);
                    return 0;
                }
            }
            i++;
        }
    }

    return 0;
}