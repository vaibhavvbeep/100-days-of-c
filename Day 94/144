#include <stdio.h>

struct Student {
    char name[100];
    int roll_no;
    int marks;
};

void printStudent(struct Student s) {
    printf("Name: %s | Roll: %d | Marks: %d\n", s.name, s.roll_no, s.marks);
}

int main() {
    struct Student s;

    if (scanf("%99s %d %d", s.name, &s.roll_no, &s.marks) != 3) {
        return 1;
    }

    printStudent(s);

    return 0;
}