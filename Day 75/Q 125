#include <stdio.h>

int main() {
    FILE *fp;
    char text[1000];

    fp = fopen("data.txt", "a");
    if (fp == NULL) {
        return 1;
    }

    if (fgets(text, sizeof(text), stdin) != NULL) {
        fputs(text, fp);
        fclose(fp);
        printf("File updated successfully with appended text.\n");
    } else {
        fclose(fp);
    }

    return 0;
}