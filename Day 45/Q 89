//Q89: Count frequency of a given character in a string.
#include <stdio.h>

int main() {
    char str[1000], target;
    int count = 0, i = 0;

    if (scanf("%s %c", str, &target) == 2) {
        while (str[i] != '\0') {
            if (str[i] == target) {
                count++;
            }
            i++;
        }

        printf("%d\n", count);
    }

    return 0;
}