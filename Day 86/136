#include <stdio.h>

enum MenuChoice {
    ADD,
    SUBTRACT,
    MULTIPLY
};

int main() {
    char op[20];
    int a, b;
    enum MenuChoice choice;

    if (scanf("%19s %d %d", op, &a, &b) != 3) {
        return 1;
    }

    if (op[0] == 'A') {
        choice = ADD;
    } else if (op[0] == 'S') {
        choice = SUBTRACT;
    } else if (op[0] == 'M') {
        choice = MULTIPLY;
    } else {
        return 1;
    }

    switch (choice) {
        case ADD:
            printf("%d\n", a + b);
            break;
        case SUBTRACT:
            printf("%d\n", a - b);
            break;
        case MULTIPLY:
            printf("%d\n", a * b);
            break;
    }

    return 0;
}