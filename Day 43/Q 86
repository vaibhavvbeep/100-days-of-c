//Q86: Check if a string is a palindrome.
#include <stdio.h>

int main() {
    char str[1000];
    int len = 0, i, is_palindrome = 1;

    if (fgets(str, sizeof(str), stdin) != NULL) {
        while (str[len] != '\0' && str[len] != '\n') {
            len++;
        }

        for (i = 0; i < len / 2; i++) {
            if (str[i] != str[len - 1 - i]) {
                is_palindrome = 0;
                break;
            }
        }
    }

    if (is_palindrome) {
        printf("Palindrome\n");
    } else {
        printf("Not palindrome\n");
    }

    return 0;
}