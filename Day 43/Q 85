//Q85: Reverse a string.
#include <stdio.h>

int main() {
    char str[1000];
    int len = 0, i;

    if (fgets(str, sizeof(str), stdin) != NULL) {
        while (str[len] != '\0' && str[len] != '\n') {
            len++;
        }

        for (i = 0; i < len / 2; i++) {
            char temp = str[i];
            str[i] = str[len - 1 - i];
            str[len - 1 - i] = temp;
        }

        str[len] = '\0';
    }

    printf("%s\n", str);

    return 0;
}