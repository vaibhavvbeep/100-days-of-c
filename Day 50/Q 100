//Q100: Print all sub-strings of a string.
#include <stdio.h>

int main() {
    char str[1000];
    int i = 0, j, k, len = 0, first = 1;

    if (scanf("%s", str) == 1) {
        while (str[len] != '\0') {
            len++;
        }

        for (i = 0; i < len; i++) {
            for (j = i; j < len; j++) {
                if (!first) {
                    printf(",");
                }
                for (k = i; k <= j; k++) {
                    printf("%c", str[k]);
                }
                first = 0;
            }
        }
        printf("\n");
    }

    return 0;
}