//Q76: Check if a matrix is symmetric.
#include <stdio.h>

int main() {
    int rows, cols, i, j, is_symmetric = 1;

    scanf("%d %d", &rows, &cols);

    int a[rows][cols];

    for (i = 0; i < rows; i++) {
        for (j = 0; j < cols; j++) {
            scanf("%d", &a[i][j]);
        }
    }

    if (rows != cols) {
        is_symmetric = 0;
    } else {
        for (i = 0; i < rows; i++) {
            for (j = 0; j < cols; j++) {
                if (a[i][j] != a[j][i]) {
                    is_symmetric = 0;
                    break;
                }
            }
            if (!is_symmetric) {
                break;
            }
        }
    }

    if (is_symmetric) {
        printf("True\n");
    } else {
        printf("False\n");
    }

    return 0;
}